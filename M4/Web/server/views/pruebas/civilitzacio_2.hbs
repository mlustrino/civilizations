<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
  {{> header}}
  <title>Civilizations - Civilization Resources</title>
</head>
<body>
    {{> navbar}}

<main class="container animate-fade">
        <h1>Civilization Resources</h1>
        <p>Production statistics and current warehouse capacity.</p>

        <div class="resources-grid">
            <div class="card">
                <h3>🌾 FOOD</h3>
                <div class="value">4,870,000</div>
            </div>
            <div class="card">
                <h3>🪵 WOOD</h3>
                <div class="value">45,000</div>
            </div>
            <div class="card">
                <h3>🪙 IRON</h3>
                <div class="value">429,000</div>
            </div>
            <div class="card">
                <h3>✨ MANA</h3>
                <div class="value">0</div>
            </div>
        </div>

        <h2 style="margin-top: 3rem; color: var(--gold);">Constructed Buildings and Buffs</h2>
        <ul>
            <li><strong>Farms:</strong> 2 complete units (+20% global food).</li>
            <li><strong>Carpentry:</strong> 1 complete unit (+10% global wood).</li>
            <li><strong>Blacksmith:</strong> 1 complete unit (+10% global iron).</li>
            <li><strong>Mage Tower:</strong> 0 units (No active mana generation).</li>
        </ul>
    </main>
  {{> footer}}
</body>
</html>
