<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
  {{> header}}
  <title>Civilizations - Main</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    {{> navbar}}

  <main class="container animate-fade">

        <div class="hero">
            <h1>Civilizations Control Panel</h1>
            <p>Manage your empire's status, review reports, and plan your strategy.</p>
        </div>

        <h2>Last 2 Battles Played</h2>
        <table>
            <thead>
                <tr>
                    <th>Battle ID</th>
                    <th>Battle #</th>
                    <th>Resources Generated</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                {{#each battles}}
                <tr>
                    <td>#{{this.battle_id}}</td>
                    <td>{{this.num_battle}}</td>
                    <td>
                        <div class="resource-item">
                            <span class="icon-resource">🪵</span> Wood: <strong class="resource-value">{{formatNumber this.wood_acquired}}</strong>
                        </div>
                        <div class="resource-item">
                            <span class="icon-resource">🪨</span> Iron: <strong class="resource-value">{{formatNumber this.iron_acquired}}</strong>
                        </div>
                    </td>
                    <td><a href="/informes?informe={{this.battle_id}}" class="btn">View Report</a></td>
                </tr>
                {{/each}}
            </tbody>
        </table>

        <!-- SECCIÓN DE IMÁGENES DEL IMPERIO -->
        <h2>Empire Overviews</h2>
        <div class="resources-grid empire-gallery">
            <div class="card gallery-card">
                <h3>Main Screen</h3>
                <div class="image-container">
                    <img src="/img/inicio.png" alt="Main Screen">
                </div>
                <p>Main command center of the civilization.</p>
            </div>

            <div class="card gallery-card">
                <h3>Our City</h3>
                <div class="image-container">
                    <img src="/img/civilization.png" alt="Our City">
                </div>
                <p>Overview of buildings and resource generation.</p>
            </div>

            <div class="card gallery-card">
                <h3>Barracks & Troops</h3>
                <div class="image-container">
                    <img src="/img/gen_tropas.png" alt="Barracks & Troops">
                </div>
                <p>Recruit and train your medieval army.</p>
            </div>
        </div>

  </main>

  {{> footer}}
</body>
</html>
